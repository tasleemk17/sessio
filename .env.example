# Copy to .env (never commit .env). Used by docker compose and by local runs.

# A long random string that signs login tokens (at least 32 characters; production refuses to start without it).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Razorpay TEST keys (they start with rzp_test_). Leave empty to use the built-in demo payment button.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you choose when you add the webhook in the Razorpay dashboard (see docs/SECURITY.md).
RAZORPAY_WEBHOOK_SECRET=

# Demo payment button when no keys are set. On a public site this lets anybody book for free: keep it false there.
ALLOW_MOCK_PAYMENTS=true

PLATFORM_FEE_PERCENT=10
