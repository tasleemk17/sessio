# Copy to .env (never commit .env). Used by docker compose and by local runs.

# A long random string that signs login tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. Leave empty and payments run in demo (mock) mode, no account needed.
# For real Razorpay Checkout in TEST mode, put your test keys here (they start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PLATFORM_FEE_PERCENT=10
